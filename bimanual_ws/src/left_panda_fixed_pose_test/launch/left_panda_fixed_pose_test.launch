<launch>
  <arg name="robot_ip" default="172.16.0.20"/>
  <arg name="arm_id" default="panda_left"/>
  <arg name="load_gripper" default="false"/>

  <!--
    The Franka hardware is put in namespace /panda_left.
    arm_id remains panda_left, producing resources such as:
      panda_left_robot
      panda_left_model
      panda_left_joint1 ... panda_left_joint7
  -->
  <group ns="panda_left">
    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip)"/>
      <arg name="arm_id" value="$(arg arm_id)"/>
      <arg name="load_gripper" value="$(arg load_gripper)"/>
    </include>

    <rosparam
        command="load"
        file="$(find left_panda_fixed_pose_test)/config/controller.yaml"/>

    <node
        pkg="controller_manager"
        type="spawner"
        name="left_fixed_pose_spawner"
        output="screen"
        args="left_fixed_pose_controller"/>
  </group>
</launch>
