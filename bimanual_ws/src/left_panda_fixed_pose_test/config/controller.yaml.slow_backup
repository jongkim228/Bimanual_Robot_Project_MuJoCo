left_fixed_pose_controller:
  type: left_panda_fixed_pose_test/FixedPoseController
  arm_id: panda_left

  # Start conservatively.
  motion_duration: 10.0

  # Per commanded motion.
  maximum_translation: 0.05
  maximum_rotation: 0.20

  # Estimated trajectory peak limits.
  maximum_linear_velocity: 0.015
  maximum_angular_velocity: 0.08

  # All coordinates are relative to panda_left_link0.
  # These are sanity limits, not collision checking.
  workspace:
    min_x: 0.15
    max_x: 0.75
    min_y: -0.50
    max_y: 0.50
    min_z: 0.08
    max_z: 0.75

  # Placeholder only.
  # Replace this after measuring the actual current pose.
  target:
    position: [0.45, 0.00, 0.40]
    orientation_xyzw: [1.0, 0.0, 0.0, 0.0]
