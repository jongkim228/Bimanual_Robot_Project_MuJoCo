<mujoco model="panda nohand">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast" impratio="10"/>
  

  <default>
    <default class="panda_left">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
      <default class="panda_left/finger">
        <joint axis="0 1 0" type="slide" range="0 0.04"/>
      </default>

      <default class="panda_left/visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="panda_left/collision">
        <geom type="mesh" group="3"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  

  <worldbody>
    <light name="top" pos="0 0 2" mode="trackcom"/>
    <body name ="left_base" pos = "0 0.4 0.3">
    <body name="left_link0" childclass="panda_left">
    
      <inertial mass="0.629769" pos="-0.041018 -0.00014 0.049974"
        fullinertia="0.00315 0.00388 0.004285 8.2904e-7 0.00015 8.2299e-6"/>
      <geom mesh="link0_0" material="off_white" class="panda_left/visual"/>
      <geom mesh="link0_1" material="dark_grey" class="panda_left/visual"/>
      <geom mesh="link0_2" material="off_white" class="panda_left/visual"/>
      <geom mesh="link0_3" material="dark_grey" class="panda_left/visual"/>
      <geom mesh="link0_4" material="off_white" class="panda_left/visual"/>
      <geom mesh="link0_5" material="dark_grey" class="panda_left/visual"/>
      <geom mesh="link0_7" material="white" class="panda_left/visual"/>
      <geom mesh="link0_8" material="white" class="panda_left/visual"/>
      <geom mesh="link0_9" material="dark_grey" class="panda_left/visual"/>
      <geom mesh="link0_10" material="off_white" class="panda_left/visual"/>
      <geom mesh="link0_11" material="white" class="panda_left/visual"/>
      <geom mesh="link0_c" class="panda_left/collision"/>
      <body name="left_link1" pos="0 0 0.333" gravcomp="1">
        <inertial mass="4.970684" pos="0.003875 0.002081 -0.04762"
          fullinertia="0.70337 0.70661 0.0091170 -0.00013900 0.0067720 0.019169"/>
        <joint name="left_joint1"/>
        <geom material="white" mesh="link1" class="panda_left/visual"/>
        <geom mesh="link1_c" class="panda_left/collision"/>
        <body name="left_link2" quat="1 -1 0 0" gravcomp="1">
          <inertial mass="0.646926" pos="-0.003141 -0.02872 0.003495"
            fullinertia="0.0079620 2.8110e-2 2.5995e-2 -3.925e-3 1.0254e-2 7.04e-4"/>
          <joint name="left_joint2" range="-1.7628 1.7628"/>
          <geom material="white" mesh="link2" class="panda_left/visual"/>
          <geom mesh="link2_c" class="panda_left/collision"/>
          <body name="left_link3" pos="0 -0.316 0" quat="1 1 0 0" gravcomp="1">
            <joint name="left_joint3"/>
            <inertial mass="3.228604" pos="2.7518e-2 3.9252e-2 -6.6502e-2"
              fullinertia="3.7242e-2 3.6155e-2 1.083e-2 -4.761e-3 -1.1396e-2 -1.2805e-2"/>
            <geom mesh="link3_0" material="white" class="panda_left/visual"/>
            <geom mesh="link3_1" material="white" class="panda_left/visual"/>
            <geom mesh="link3_2" material="white" class="panda_left/visual"/>
            <geom mesh="link3_3" material="dark_grey" class="panda_left/visual"/>
            <geom mesh="link3_c" class="panda_left/collision"/>
            <body name="left_link4" pos="0.0825 0 0" quat="1 1 0 0" gravcomp="1">
              <inertial mass="3.587895" pos="-5.317e-2 1.04419e-1 2.7454e-2"
                fullinertia="2.5853e-2 1.9552e-2 2.8323e-2 7.796e-3 -1.332e-3 8.641e-3"/>
              <joint name="left_joint4" range="-3.0718 -0.0698"/>
              <geom mesh="link4_0" material="white" class="panda_left/visual"/>
              <geom mesh="link4_1" material="white" class="panda_left/visual"/>
              <geom mesh="link4_2" material="dark_grey" class="panda_left/visual"/>
              <geom mesh="link4_3" material="white" class="panda_left/visual"/>
              <geom mesh="link4_c" class="panda_left/collision"/>
              <body name="link5" pos="-0.0825 0.384 0" quat="1 -1 0 0" gravcomp="1">
                <inertial mass="1.225946" pos="-1.1953e-2 4.1065e-2 -3.8437e-2"
                  fullinertia="3.5549e-2 2.9474e-2 8.627e-3 -2.117e-3 -4.037e-3 2.29e-4"/>
                <joint name="left_joint5"/>
                <geom mesh="link5_0" material="dark_grey" class="panda_left/visual"/>
                <geom mesh="link5_1" material="white" class="panda_left/visual"/>
                <geom mesh="link5_2" material="white" class="panda_left/visual"/>
                <geom mesh="link5_c0" class="panda_left/collision"/>
                <geom mesh="link5_c1" class="panda_left/collision"/>
                <geom mesh="link5_c2" class="panda_left/collision"/>
                <body name="link6" quat="1 1 0 0" gravcomp="1">
                  <inertial mass="1.666555" pos="6.0149e-2 -1.4117e-2 -1.0517e-2"
                    fullinertia="1.964e-3 4.354e-3 5.433e-3 1.09e-4 -1.158e-3 3.41e-4"/>
                  <joint name="left_joint6" range="-0.0175 3.7525"/>
                  <geom mesh="link6_0" material="off_white" class="panda_left/visual"/>
                  <geom mesh="link6_1" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_2" material="dark_grey" class="panda_left/visual"/>
                  <geom mesh="link6_3" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_4" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_5" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_6" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_7" material="light_blue" class="panda_left/visual"/>
                  <geom mesh="link6_8" material="light_blue" class="panda_left/visual"/>
                  <geom mesh="link6_9" material="dark_grey" class="panda_left/visual"/>
                  <geom mesh="link6_10" material="dark_grey" class="panda_left/visual"/>
                  <geom mesh="link6_11" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_12" material="green" class="panda_left/visual"/>
                  <geom mesh="link6_13" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_14" material="dark_grey" class="panda_left/visual"/>
                  <geom mesh="link6_15" material="dark_grey" class="panda_left/visual"/>
                  <geom mesh="link6_16" material="white" class="panda_left/visual"/>
                  <geom mesh="link6_c" class="panda_left/collision"/>
                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0" gravcomp="1">
                    <inertial mass="7.35522e-01" pos="1.0517e-2 -4.252e-3 6.1597e-2"
                      fullinertia="1.2516e-2 1.0027e-2 4.815e-3 -4.28e-4 -1.196e-3 -7.41e-4"/>
                    <joint name="left_joint7"/>
                    <geom mesh="link7_0" material="white" class="panda_left/visual"/>
                    <geom mesh="link7_1" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_2" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_3" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_4" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_5" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_6" material="dark_grey" class="panda_left/visual"/>
                    <geom mesh="link7_7" material="white" class="panda_left/visual"/>
                    <geom mesh="link7_c" class="panda_left/collision"/>
                    <body name="left_attachment" pos="0 0 0.2" quat="0.3826834 0 0 0.9238795" gravcomp="1">
                      <site name="left_ee_site" quat="0 0 1 0"/>
                        <include file = "../allegro_hand_ros_v5-3Finger/src/allegro_hand_description/allegro_hand_left.xml"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </body>
  </worldbody>

  <actuator>
    <motor class="panda_left" name="left_actuator1" joint="left_joint1" forcerange="-87 87"/>
    <motor class="panda_left" name="left_actuator2" joint="left_joint2" forcerange="-87 87"
      ctrlrange="-1.7628 1.7628"/>
    <motor class="panda_left" name="left_actuator3" joint="left_joint3" forcerange="-87 87"/>
    <motor class="panda_left" name="left_actuator4" joint="left_joint4" forcerange="-87 87"
      ctrlrange="-3.0718 -0.0698"/>
    <motor class="panda_left" name="left_actuator5" joint="left_joint5" forcerange="-12 12"/>
    <motor class="panda_left" name="left_actuator6" joint="left_joint6" forcerange="-12 12"
      ctrlrange="-0.0175 3.7525"/>
    <motor class="panda_left" name="left_actuator7" joint="left_joint7" forcerange="-12 12"/>


    <position name="left_j0_0" joint="joint_0_0" kp="2" ctrlrange="-1.65 0.1"  forcerange="-15 15"/>
    <position name="left_j1_0" joint="joint_1_0" kp="2" ctrlrange="-1.75 1.06" forcerange="-15 15"/>
    <position name="left_j2_0" joint="joint_2_0" kp="2" ctrlrange="-1.45 1.45" forcerange="-15 15"/>
    <position name="left_j3_0" joint="joint_3_0" kp="2" ctrlrange="-0.1  1.65" forcerange="-15 15"/>
    <position name="left_j4_0" joint="joint_4_0" kp="2" ctrlrange="-1.75 1.06" forcerange="-15 15"/>
    <position name="left_j5_0" joint="joint_5_0" kp="2" ctrlrange="-1.45 1.45" forcerange="-15 15"/>
    <position name="left_j6_0" joint="joint_6_0" kp="2" ctrlrange="-0.6  0.6"  forcerange="-15 15"/>
    <position name="left_j7_0" joint="joint_7_0" kp="2" ctrlrange="-1.75 1.06" forcerange="-15 15"/>
    <position name="left_j8_0" joint="joint_8_0" kp="2" ctrlrange="-1.45 1.45" forcerange="-15 15"/>
  </actuator>

  <contact>
    <exclude body1="left_link0" body2="left_link1"/>
  </contact>

</mujoco>
